/dts-v1/;

#include "mt7628a.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	aliases {
		serial2 = &uart2;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = &uart2;
	};

	emmc_pwrseq: emmc_pwrseq {
		compatible = "mmc-pwrseq-emmc";
		/* MDI_TN_P1, SoC pin 42, gpio0 offset 15, active-low */
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	/*
	 * SPIS_MODE=gpio — switches MDI P1 pads to GPIO function.
	 * Required so MDI_TN_P1 (GPIO#15) is driveable as the eMMC reset output
	 * and MDI_TP_P1 (GPIO#14) is readable as the recovery-boot sensor.
	 */
	mdi_p1_gpio: mdi_p1_gpio {
		spis_gpio {
			groups = "spis";
			function = "gpio";
		};
	};
};

&uart2 {
	status = "okay";
};

&spi0 {
	status = "okay";
	num-cs = <2>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x030000 0x010000>;
			};

			partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;
			};
		};
	};
};

&mmc {
	/*
	 * sd_iot_mode: EPHY_APGIO_AIO_EN[4:1]=0xf (MDI pads → digital) +
	 * SD_MODE=0 (SDXC on EPHY P3/P4 pads) + ESD=0 (IoT routing).
	 * mdi_p1_gpio: SPIS_MODE=gpio so MDI_TN_P1 (GPIO#15) is the eMMC reset.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&sd_iot_mode &mdi_p1_gpio>;
	bus-width = <4>;
	cap-mmc-highspeed;
	/delete-property/ cap-sd-highspeed;
	non-removable;
	mmc-pwrseq = <&emmc_pwrseq>;
	status = "okay";
};
