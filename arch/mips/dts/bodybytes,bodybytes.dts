/dts-v1/;

#include "mt7628a.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	aliases {
		serial2 = &uart2;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = &uart2;
	};
};

&pinctrl {
	/*
	 *  mdi_p1_gpio:   MDI P1 pads → GPIO (hall sensor + eMMC RST_n)
	 *  ephy_iot_mode: all four EPHY groups → digital (required for MSDC CLK/CMD path)
	 */
	pinctrl-0 = <&state_default &mdi_p1_gpio &ephy_iot_mode>;

	mdi_p1_gpio: mdi_p1_gpio {
		groups = "spis";
		function = "gpio";
	};
};

&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&eth {
	status = "disabled";
};

&usb_phy {
	status = "disabled";
};

&uart2 {
	status = "okay";
};

&spi0 {
	status = "okay";
	num-cs = <2>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "factory";
				reg = <0x050000 0x010000>;
				read-only;
			};

			partition@60000 {
				label = "recovery";
				reg = <0x060000 0x3fa0000>;
				read-only;
			};
		};
	};
};

/ {
	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	};
};

&mmc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&sd_iot_mode>;

	max-frequency = <1000000>;
	/* max-frequency = <48000000>; cap-sd-highspeed; cap-mmc-highspeed; */

	bus-width = <4>;
	no-1-8-v;
	non-removable;
	builtin-cd = <0>;
	mmc-pwrseq = <&emmc_pwrseq>;
};
