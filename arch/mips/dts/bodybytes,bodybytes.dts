/dts-v1/;

#include "mt7628a.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	aliases {
		serial2 = &uart2;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = &uart2;
	};
};

&pinctrl {
	pinctrl-0 = <&state_default &mdi_p1_gpio>;

	mdi_p1_gpio: mdi_p1_gpio {
		groups = "spis";
		function = "gpio";
	};
};

&uart0 {
	status = "disabled";
};

&uart2 {
	status = "okay";
	/*
	 * ephy_iot_mode sets AGPIO_CFG[20:17]=0xf (MDI pads → digital).
	 * Without it the pads stay analog after reset and JTAG-loaded u-boot.bin
	 * produces no output. uart2_pins routes UART2 to those pads (UART2_MODE=0).
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins &ephy_iot_mode>;
};

&spi0 {
	status = "okay";
	num-cs = <2>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "factory";
				reg = <0x050000 0x010000>;
				read-only;
			};

			partition@60000 {
				label = "recovery";
				reg = <0x060000 0x3fa0000>;
				read-only;
			};
		};
	};
};

&mmc {
	status = "okay";
	bus-width = <4>;
	max-frequency = <1000000>;
	builtin-cd = <0>;

	pinctrl-names = "default";
	pinctrl-0 = <&sd_iot_mode>;
};

