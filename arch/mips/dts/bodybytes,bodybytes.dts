/dts-v1/;

#include "mt7628a.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	aliases {
		serial2 = &uart2;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = &uart2;
	};
};

&pinctrl {
	/*
	 *  mdi_p1_gpio:   MDI P1 pads → GPIO (hall sensor + eMMC RST_n)
	 *  ephy_iot_mode: all four EPHY groups → digital (required for MSDC CLK/CMD path)
	 */
	pinctrl-0 = <&state_default &mdi_p1_gpio &ephy_iot_mode>;

	mdi_p1_gpio: mdi_p1_gpio {
		groups = "spis";
		function = "gpio";
	};
};

&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&eth {
	/*
	 * Enabled only for its probe side effect. mt7628_eth_probe() →
	 * rt305x_esw_init() pulses the EPHY reset and runs mt7628_ephy_init(),
	 * which includes the "fix EPHY idle state abnormal behavior" MDIO write.
	 * SD/eMMC runs on the EPHY P1-P4 pads in IoT mode; without this bring-up
	 * those pads sit in the abnormal idle-low state and SD DAT0 never idles
	 * high (see docs/uboot-emmc.md). No mediatek,poll-link-phy → phy_connect
	 * is skipped, so probe completes with no cable. ephy_iot_mode keeps the
	 * pads digital so this never reverts them to analog (ethernet) mode.
	 */
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ephy_iot_mode>;
};

&usb_phy {
	status = "disabled";
};

&uart2 {
	status = "okay";
};

&spi0 {
	status = "okay";
	num-cs = <2>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "factory";
				reg = <0x050000 0x010000>;
				read-only;
			};

			partition@60000 {
				label = "recovery";
				reg = <0x060000 0x3fa0000>;
				read-only;
			};
		};
	};
};

/ {
	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	};
};

&mmc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&sd_iot_mode>;

	/*
	 * 26 MHz, not 48: EPHY pads are marginal; 48 MHz gave CMD-phase timeouts
	 * escalating to "Card stuck busy" + I/O errors. Needs JTAG off (EPHY strap).
	 * Above 25 MHz the driver forces rising-edge response sampling.
	 */
	max-frequency = <26000000>;
	cap-sd-highspeed;
	cap-mmc-highspeed;

	bus-width = <4>;
	no-1-8-v;
	non-removable;
	builtin-cd = <0>;
	mmc-pwrseq = <&emmc_pwrseq>;

	/*
	 * Response-sample edge. Base mt7628a.dtsi sets r_smpl = <1> (RSPL rising);
	 * the vendor SDK uses the falling edge, so force it here. This only
	 * affects the low-speed init phase — above 25 MHz the driver forces
	 * rising-edge sampling regardless. Kept at the empirically-working value.
	 * (Note: the earlier all-zero-response failure was CPU-JTAG being active,
	 * not this bit.)
	 */
	r_smpl = <0>;
};
