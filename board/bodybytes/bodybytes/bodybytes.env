bootlimit=3
dram_staging=0x82000000
dram_staging_max=0x02000000
gpio_recovery=14
mmc_dev=0
mmc_part=kernel
block_size=0x200
block_mask=0x1ff
sf_recovery=0x60000
sf_recovery_max=0x01fa0000

fit_get_size=if fdt addr -q ${dram_staging}; then if fdt header get fit_size totalsize; then fdt addr ${fdtcontroladdr}; itest ${fit_size} -ge 0x40 && itest ${fit_size} -le ${dram_staging_max}; else echo "FIT totalsize unavailable"; fdt addr ${fdtcontroladdr}; false; fi; else echo "Invalid FIT header"; fdt addr ${fdtcontroladdr}; false; fi

fit_load_mmc=mmc dev ${mmc_dev} && mmc rescan && part start mmc ${mmc_dev} ${mmc_part} fit_start && part size mmc ${mmc_dev} ${mmc_part} fit_max_blocks && itest ${fit_max_blocks} -ge 1 && mmc read ${dram_staging} ${fit_start} 1 && run fit_get_size && setexpr fit_blocks ${fit_size} + ${block_mask} && setexpr fit_blocks ${fit_blocks} / ${block_size} && itest ${fit_blocks} -ge 1 && itest ${fit_blocks} -le ${fit_max_blocks} && echo "Loading eMMC FIT: ${fit_size} bytes, ${fit_blocks} blocks" && mmc read ${dram_staging} ${fit_start} ${fit_blocks}

fit_load_sf=sf probe && sf read ${dram_staging} ${sf_recovery} ${block_size} && run fit_get_size && itest ${fit_size} -le ${sf_recovery_max} && echo "Loading NOR FIT: ${fit_size} bytes" && sf read ${dram_staging} ${sf_recovery} ${fit_size}

boot_mmc=echo "Booting eMMC FIT" && run fit_load_mmc && bootm ${dram_staging}

boot_sf=echo "Booting NOR recovery FIT" && run fit_load_sf && bootm ${dram_staging}

boot_selected=if run boot_mmc; then true; else echo "eMMC boot failed"; run boot_sf; fi

bootcmd=echo "Boot count: ${bootcount} / ${bootlimit}"; gpio input ${gpio_recovery}; if gpio read recovery_state ${gpio_recovery}; then if test "${recovery_state}" = "0"; then echo "Recovery sensor triggered"; run boot_sf; else echo "Recovery sensor not triggered"; run boot_selected; fi; else echo "Recovery GPIO unavailable"; run boot_sf; fi

altbootcmd=echo "Boot count: ${bootcount} / ${bootlimit} - limit exceeded"; run boot_sf

bootmenu_0=Normal boot=run boot_selected
bootmenu_1=Recovery boot=run boot_sf
bootmenu_2=U-Boot shell=
