# SPDX-License-Identifier: GPL-2.0
#
# Default U-Boot environment for bodybytes.
#
# This file is the single source of truth for all boot variables.
# The U-Boot build system auto-detects it and compiles it into
# default_environment[].  scripts/generate_nor_image.py also passes it
# directly to u-boot/tools/mkenvimage to pre-program the NOR env partition.
#
# GPIO#14 (MDI_TP_P1): TI DRV5032FCDBZT hall-effect sensor, active-low.
#   low  = magnet present -> recovery: bootm from NOR memory-mapped window
#   high = no magnet      -> normal:   load kernel from eMMC GPT partition 1
#
# 0xBC060000 = NOR KSEG1 alias of physical 0x1C060000 (NOR offset 0x060000).
# part size reads the exact GPT partition size in sectors so mmc read transfers
# only the kernel partition and no more.
#
# bootargs must be set explicitly in each boot command before bootm so U-Boot
# overwrites the DTS chosen/bootargs with the correct value.  Recovery boots an
# initramfs so no root= is needed; normal boot passes root=/dev/mmcblk0p2 so the
# kernel can mount the squashfs rootfs on GPT partition 2, and fstools can then
# scan mmcblk0 partitions by GPT label name to set up the rootfs_data overlay.
# root=PARTLABEL=... must NOT be used — fstools partname.c returns NULL for
# non-/dev/ root= values unless fstools_partname_fallback_scan=1 is also set.

bootcmd=gpio input 14; if gpio read 14; then run bootcmd_recovery; else run bootcmd_normal; fi
bootcmd_recovery=echo 'Boot: recovery (NOR)'; setenv bootargs console=ttyS2,115200; bootm 0xBC060000
bootcmd_normal=echo 'Boot: normal (eMMC)'; setenv bootargs console=ttyS2,115200 root=/dev/mmcblk0p2 rootwait; mmc dev 0; part start mmc 0 1 ks; part size mmc 0 1 kz; mmc read 0x82000000 ${ks} ${kz}; bootm 0x82000000
bootmenu_0=Normal boot (eMMC)=run bootcmd_normal
bootmenu_1=Recovery boot (NOR)=run bootcmd_recovery
bootmenu_2=U-Boot shell=
altbootcmd=run bootcmd_recovery
