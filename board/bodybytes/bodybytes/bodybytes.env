kernel_addr_r=0x82000000

bootcmd_normal=echo "Boot: normal (eMMC)"; if mmc dev 0 && mmc rescan && part start mmc 0 1 kern_start && part size mmc 0 1 kern_blocks && mmc read ${kernel_addr_r} ${kern_start} ${kern_blocks}; then bootm ${kernel_addr_r}; else echo "Normal boot failed"; run bootcmd_recovery; fi
bootcmd_recovery=echo "Boot: recovery (NOR)"; sf probe && sf read ${kernel_addr_r} 0x60000 0x1000000 && bootm ${kernel_addr_r}
bootcmd=gpio input 14; if gpio read 14; then run bootcmd_recovery; else run bootcmd_normal; fi

altbootcmd=run bootcmd_recovery

bootmenu_0=Normal boot (eMMC)=run bootcmd_normal
bootmenu_1=Recovery boot (NOR)=run bootcmd_recovery
bootmenu_2=U-Boot shell=